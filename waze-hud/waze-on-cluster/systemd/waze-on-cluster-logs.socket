[Unit]
Description=waze-on-cluster logs socket

[Socket]
# The iDrive app's Logs page connects here, which starts
# waze-on-cluster-logs.service. Every OAP app process has tm_oap_app as a
# supplementary group.
ListenStream=/dev/shm/waze-on-cluster/logs.sock
DirectoryMode=0755
SocketMode=0660
SocketGroup=tm_oap_app

[Install]
WantedBy=sockets.target
