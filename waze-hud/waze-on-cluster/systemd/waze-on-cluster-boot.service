[Unit]
Description=waze-on-cluster boot check: restore the original carplay before it starts if the map patch crash-loops
RequiresMountsFor=/var/opt
After=local-fs.target
# carplay.service (WantedBy=late.target, after multi-user.target) starts only
# once this has finished, failed or timed out; it does not require it.
Before=carplay.service

[Service]
# Root, like patchd: at the crash threshold, or when it cannot save this
# boot's record, it remounts / read-write only to run the vetted
# carplay_patch.js revert of a restorable patch, then read-only again
# (PATCH.md "Boot recovery"). Otherwise it counts the previous boot, arms this
# one and exits in about a second.
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/bin/node /var/opt/waze-on-cluster/current/recovery.js boot carplay
# Below the threshold carplay waits about the time Node takes to start; a
# restore takes seconds. Every command a restore runs is bounded, so it ends
# within 111 s (recovery.js BOOT_BOUND_MS: up to 20 s for the other boot
# step's restore, then RESTORE_BOUND_MS), inside the start timeout: carplay
# is held back 120 s at most, and only when those commands hang. A stop
# mid-restore lets it finish, inside the stop timeout, so / is not left
# writable; KillMode=mixed signals only the step, not its mount/revert children.
TimeoutStartSec=120
TimeoutStopSec=120
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
